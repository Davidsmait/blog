---
import PageLayout from '../../layouts/PageLayout.astro'
import { getPruebasPublicas, METODO_LABEL } from '@/util/laboratorio'

const pruebas = await getPruebasPublicas()

const fmtFecha = (iso: string) =>
  new Date(iso).toLocaleDateString('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'America/Mexico_City'
  })

const atributos = [
  ['acidez', 'Acidez'],
  ['dulzor', 'Dulzor'],
  ['cuerpo', 'Cuerpo'],
  ['amargor', 'Amargor'],
  ['final', 'Final']
] as const
---

<PageLayout
  frontmatter={{
    title: 'Laboratorio de Café — Mis pruebas',
    description:
      'Bitácora pública de pruebas de café de especialidad: recetas de espresso y filtrado con molienda, ratio, tiempos, vertidos y evaluación al estilo SCA.',
    activeHeaderLink: 'Café'
  }}
>
  <div class="lab-page">
    <div class="lab-header">
      <span class="lab-label">Laboratorio</span>
      <h1 class="lab-title">Mis pruebas de café</h1>
      <p class="lab-sub">
        Recetas que funcionaron, con todos sus números. Evaluación en dos capas:
        intensidad de 1 a 5 y calificación de 6 a 10 al estilo SCA.
      </p>
    </div>

    {
      pruebas.length === 0 ? (
        <p class="lab-empty">
          Todavía no hay pruebas publicadas. Las primeras vienen pronto.
        </p>
      ) : (
        <div class="lab-grid">
          {pruebas.map((p) => (
            <article class="lab-card">
              <header class="lab-card-head">
                <span class="lab-chip">{METODO_LABEL[p.metodo]}</span>
                {p.evaluacion.calificacion !== null && (
                  <span class="lab-score">{p.evaluacion.calificacion}</span>
                )}
              </header>
              <h2 class="lab-card-title">{p.titulo ?? p.cafe.nombre ?? 'Prueba'}</h2>
              <p class="lab-meta">
                {[p.cafe.tostador, p.cafe.origen, p.cafe.proceso, p.cafe.variedad]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
              <dl class="lab-receta">
                <div><dt>Dosis</dt><dd>{p.dosis_g} g</dd></div>
                {p.ratio !== null && (
                  <div><dt>Ratio</dt><dd>1:{p.ratio}</dd></div>
                )}
                {p.molienda !== null && (
                  <div><dt>Molienda</dt><dd>{p.molienda}{p.molino ? ` (${p.molino})` : ''}</dd></div>
                )}
                {p.temp_c !== null && (
                  <div><dt>Agua</dt><dd>{p.temp_c} °C</dd></div>
                )}
                {p.tiempo_total_s !== null && (
                  <div><dt>Tiempo</dt><dd>{p.tiempo_total_s} s</dd></div>
                )}
                {p.familia === 'espresso' && p.preinfusion_total_s !== null && (
                  <div>
                    <dt>Preinfusión</dt>
                    <dd>{p.preinfusion_agua_s ?? '—'} s agua · bomba en {p.preinfusion_total_s} s</dd>
                  </div>
                )}
                {p.presion_bar !== null && (
                  <div><dt>Presión</dt><dd>{p.presion_bar} bar</dd></div>
                )}
                {p.dias_desde_tueste !== null && (
                  <div><dt>Tueste</dt><dd>{p.dias_desde_tueste} días</dd></div>
                )}
              </dl>
              {p.vertidos.length > 0 && (
                <ol class="lab-vertidos">
                  {p.vertidos.map((v) => (
                    <li>
                      <span>{v.t_s} s</span> {v.g} g{v.tipo ? ` · ${v.tipo}` : ''}
                    </li>
                  ))}
                </ol>
              )}
              <div class="lab-eval">
                {atributos.map(([k, label]) =>
                  p.evaluacion[k] !== null ? (
                    <div class="lab-bar">
                      <span>{label}</span>
                      <span class="lab-bar-track">
                        <span
                          class="lab-bar-fill"
                          style={`width:${(Number(p.evaluacion[k]) / 5) * 100}%`}
                        />
                      </span>
                    </div>
                  ) : null
                )}
              </div>
              {p.evaluacion.descriptores.length > 0 && (
                <p class="lab-desc">{p.evaluacion.descriptores.join(', ')}</p>
              )}
              {p.notas && <p class="lab-notas">{p.notas}</p>}
              <footer class="lab-fecha">{fmtFecha(p.fecha)}</footer>
            </article>
          ))}
        </div>
      )
    }
  </div>
</PageLayout>

<style>
  .lab-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  .lab-header {
    margin-bottom: 2rem;
  }
  .lab-label {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.6;
    margin-bottom: 0.75rem;
  }
  .lab-title {
    font-family: var(--font-display, 'Instrument Serif', serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
  }
  .lab-sub {
    font-size: 0.875rem;
    opacity: 0.6;
    margin-top: 0.5rem;
    max-width: 40rem;
  }
  .lab-empty {
    opacity: 0.6;
    font-style: italic;
  }
  .lab-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 720px) {
    .lab-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .lab-card {
    border: 1px solid color-mix(in srgb, currentcolor 12%, transparent);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .lab-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .lab-chip {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .lab-score {
    font-family: var(--font-display, 'Instrument Serif', serif);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-accent);
  }
  .lab-card-title {
    font-family: var(--font-display, 'Instrument Serif', serif);
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0;
  }
  .lab-meta,
  .lab-fecha {
    font-size: 0.8rem;
    opacity: 0.6;
    margin: 0;
  }
  .lab-receta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .lab-receta dt {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }
  .lab-receta dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .lab-vertidos {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .lab-vertidos span {
    opacity: 0.6;
  }
  .lab-eval {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.75rem;
  }
  .lab-bar {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .lab-bar-track {
    height: 0.35rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentcolor 10%, transparent);
    overflow: hidden;
  }
  .lab-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
  }
  .lab-desc {
    font-size: 0.85rem;
    font-style: italic;
    margin: 0;
  }
  .lab-notas {
    font-size: 0.85rem;
    margin: 0;
    opacity: 0.85;
  }
</style>
